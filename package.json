{
  "name": "hid-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bancada HID do Keychron K3 Pro: relatório cru 3434:0230 e JSONL em /tmp/hid-tester.jsonl.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puppe1990/hid-tester.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib --no-default-features --quiet",
    "dev": "tauri dev",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm test",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8"
  }
}
